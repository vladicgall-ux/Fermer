# Домен, направленный на IP сервера (A-запись). Caddy сам выпустит HTTPS-сертификат.
DOMAIN=fermer.example.ru

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# PostgreSQL. Можно оставить текущую базу Supabase (строка подключения к pooler) или свою.
DATABASE_URL=

# Telegram ID первых администраторов через запятую.
ADMIN_TELEGRAM_IDS=

# Только для своей базы на сервере (профиль localdb): пароль пользователя fermer.
DB_PASSWORD=
