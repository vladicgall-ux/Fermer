# Токен бота от @BotFather. Используется для проверки initData (HMAC-SHA256). Обязателен.
TELEGRAM_BOT_TOKEN=

# Строка подключения к PostgreSQL (Vercel Postgres/Neon — POSTGRES_URL подхватывается автоматически;
# Supabase — строка Supavisor pooler, порт 6543).
DATABASE_URL=

# Telegram ID первых администраторов через запятую (узнать свой id: @userinfobot).
# Эти пользователи всегда админы и не могут быть сняты из интерфейса. Можно оставить пустым
# и назначить админа SQL-запросом (см. README).
ADMIN_TELEGRAM_IDS=

# Дополнительные разрешённые origin для CORS (через запятую). Origin самого приложения разрешён всегда.
APP_URL=

# Срок действия initData в секундах (по умолчанию 86400 = 24 часа).
INITDATA_MAX_AGE_SEC=

# Только для `next dev` вне Telegram: npm run dev:initdata -- <telegram_id> "<Имя>"
NEXT_PUBLIC_DEV_INIT_DATA=
